{
  "name": "@memory-map/api",
  "version": "0.1.0",
  "private": true,
  "description": "Memory Map backend API",
  "scripts": {
    "build": "nest build",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "dev": "dotenv -e ../../.env -- cross-env PORT=3021 nest start --watch",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "start": "nest start",
    "start:dev": "dotenv -e ../../.env -- cross-env PORT=3021 nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --config ./jest.config.js",
    "test:contract": "jest --config ./jest.config.js --runTestsByPath test/integration/api-contract-smoke.spec.ts",
    "test:db": "jest --config ./jest.config.js --runTestsByPath test/integration/pins-postgis-db.spec.ts",
    "test:property": "jest --config ./jest.property.config.js --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "fast-check": "^4.0.0",
    "jest": "^29.7.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  }
}
