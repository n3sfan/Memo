# Copy this file to .env for local Docker Compose.
# Never commit real values.

# Docker Compose service settings
COMPOSE_PROJECT_NAME=memory-map
API_BIND_HOST=127.0.0.1
API_HOST_PORT=3000
API_BASE_URL=http://localhost:3000/api/v1
SHARE_PUBLIC_BASE_URL=https://memo.app

# PostgreSQL/PostGIS
POSTGRES_DB=memory_map
POSTGRES_USER=memory_map
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://memory_map:replace-with-a-long-random-password@127.0.0.1:5432/memory_map?schema=public

# Backend runtime
NODE_ENV=production
PORT=3000
JWT_ACCESS_SECRET=replace-with-32-plus-byte-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-plus-byte-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Redis
# In Docker Compose the API uses redis://redis:6379/0.
# For PM2 on the host, use redis://127.0.0.1:6379/0 if Redis is published locally.
REDIS_URL=redis://redis:6379/0
REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=6379

# Cloudflare R2 / S3-compatible object storage
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=memory-map-media
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=10485760

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
APPLE_OAUTH_CLIENT_ID=replace-with-apple-service-id-or-bundle-id
APPLE_OAUTH_TEAM_ID=replace-with-apple-team-id
APPLE_OAUTH_KEY_ID=replace-with-apple-key-id
APPLE_OAUTH_PRIVATE_KEY_BASE64=base64-encoded-private-key
OAUTH_CALLBACK_BASE_URL=https://api.example.com/api/v1
OAUTH_APP_REDIRECT_BASE_URL=http://localhost:5000

# Nginx rendering scripts
NGINX_DOMAIN=api.example.com
API_UPSTREAM=127.0.0.1:3000
TLS_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem
